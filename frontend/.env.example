# Frontend settings. Vite bakes VITE_* values into the bundle at build time,
# so changing one needs a rebuild. Never put a server secret here.

# The dialer API. Empty = same origin (the Vite dev server proxies /api to :4000).
VITE_API_URL=

# The browser softphone: a SIP credential on Telnyx (or any SIP-over-WebSocket
# provider, see docs/sip-providers.md).
VITE_SIP_PROVIDER=telnyx
VITE_SIP_URI=sip:your-username@sip.telnyx.com
VITE_SIP_PASSWORD=
VITE_SIP_WS_URL=wss://sip.telnyx.com:7443
VITE_SIP_CALLER_ID=+15551234567
