{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "baseUrl": ".",
    "paths": { "@/*": ["frontend/src/*"] },
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "noEmit": true
  },
  "include": [
    "server",
    "frontend/src",
    "vite.config.ts"
  ]
}
