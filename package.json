{
  "name": "dialer",
  "private": true,
  "type": "module",
  "description": "Browser-based cold calling dialer with a native Twenty CRM integration.",
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"bun run dev:backend\" \"bun run dev:frontend\"",
    "dev:backend": "bun run --cwd backend dev",
    "dev:frontend": "bun run --cwd frontend dev",
    "install:all": "bun install && bun run build:shared && bun run --cwd backend install && bun run --cwd frontend install",
    "api:client": "bun run --cwd packages/shared api:client",
    "api:check": "bun run --cwd packages/shared api:check",
    "build": "bun run build:shared && bun run build:backend && bun run build:frontend",
    "build:shared": "bun run --cwd packages/shared build",
    "build:backend": "bun run --cwd backend build",
    "build:frontend": "bun run --cwd frontend build",
    "start": "bun run --cwd backend start",
    "preview": "bun run --cwd frontend preview",
    "check:docs": "node scripts/check-docs.mjs",
    "check:scope": "node scripts/check-scope.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "docs:telnyx": "node scripts/pull-telnyx-docs.mjs",
    "docs:twenty": "node scripts/pull-twenty-docs.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
