# Open Twenty Dialer Backend Environment
# Copy this file to .env.local and fill in the values

# Twenty CRM (required for sync)
TWENTY_BASE_URL=https://twenty.inferencesaver.com
TWENTY_API_KEY=your-twenty-api-key-here

# Twenty Postgres — read-only creds for verifying member passwords
# Create a role like: CREATE ROLE dialer_ro LOGIN PASSWORD '...';
# GRANT CONNECT ON DATABASE twenty TO dialer_ro;
# GRANT USAGE ON SCHEMA core TO dialer_ro;
# GRANT SELECT ON core."user" TO dialer_ro;
TWENTY_DATABASE_URL=postgres://dialer_ro:your-password@node01:5432/twenty

# Sync settings
SYNC_POLL_INTERVAL_MS=30000

# Claim lock: a non-IDLE number claim older than this (minutes) with no
# activity is treated as abandoned — the next claim takes the number and
# anyone may release it. Covers tabs closed mid-call (see docs/identity.md
# sign-in flow and the Softphone pagehide flush).
CLAIM_STALE_AFTER_MINUTES=60

# Backend
PORT=4000
# Required: random secret, at least 32 characters. The backend refuses to
# boot without it. Dialer JWTs live 24h; there is no refresh endpoint yet,
# so Rosa/Pablo re-authenticate via Twenty SSO after expiry.
JWT_SECRET=your-jwt-secret-here

# Public origin of the deployed frontend (used for CORS and Bark deep links,
# which open {FRONTEND_URL}/leads/{id}; unset FRONTEND_URL falls back to the
# incoming request origin).
# Local dev servers http://localhost:5173 and http://localhost:5174 are
# always allowed in addition to this value.
FRONTEND_URL=

# Bark push (per-member BARK_KEY on workspaceMember.barkKey)
# Public server default is https://api.day.app — set this only for self-hosted.
BARK_SERVER_URL=https://api.day.app

# Twenty native webhooks (Settings → APIs & Webhooks → Webhooks →
# https://<backend>/api/twenty/webhooks). Either secret gates the receiver;
# HMAC is preferred, ?token= matches the Telnyx-webhook precedent.
TWENTY_WEBHOOK_SECRET=
TWENTY_WEBHOOK_TOKEN=
