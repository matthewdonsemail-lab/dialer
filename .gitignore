# Dependencies
node_modules/
.pnpm-store/
__pycache__/
*.py[cod]
.venv/
venv/

# Environment & secrets
.env
.env.local
.env.*.local
# Bare env dumps: ad-hoc `env.txt` / `NOKIA/frontend/env.txt` style secret
# files. They are NOT covered by `.env*` and would otherwise be swept in by
# `git add -A`. Never commit these.
env.txt
**/env.txt
*.pem
*.key
temp_login.json
# HTTP Archive files: browser/devtools HAR exports record every request and
# response header, so they capture Authorization and Cookie values verbatim.
# Treat them as secrets; never commit.
*.har
**/*.har

# Build & dist
dist/
build/
out/
*.tsbuildinfo
.vercel/
.scratch/
coverage/
data/

# Logs & debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ---------------------------------------------------------------------------
# Out of scope for the dialer application.
# These live on local/dev machines, on host boxes, or in other repositories.
# They are never part of the tracked application surface.
# ---------------------------------------------------------------------------

# Host-specific infrastructure (node01 docker-compose, tailnet addresses).
# The two files the build needs are promoted into docker/ (nginx.embed.conf,
# hostinger.htaccess).
ops/

# Unrelated Railcode app (a separate product surface).
matthew-onboarding/

# Vendored copies of external agent skills, kept in sync out of band.
# Canonical copies live in the user-level skill directories.
agent/
.agents/
.claude/

# Vendored third-party skill definitions inside the Twenty app.
twenty-native-app/src/skills/

# Deploy staging output (regenerated by scripts/deploy.sh).
hostinger/

# One-off local Twenty schema inspection and migration helpers.
# See scripts/twenty-schema/README.md. Some of these historically hardcoded a
# workspace API key, so the whole directory stays out of git.
backend/scripts/

# ---------------------------------------------------------------------------
# External documentation, mirrored locally by scripts/pull-*-docs.mjs.
# Tracked project documentation lives beside them; these are not.
# Only libraries the dialer actually depends on are mirrored: Telnyx for SIP
# and Call Control, and the Twenty app SDK for the native app.
# ---------------------------------------------------------------------------
docs/telnyx/upstream/
docs/twenty/upstream/

.vercel
.env*

# Codemod scratch path maps (scripts/codemods/relayout.mjs)
.relayout-*.json
